# Last.fm
LASTFM_USER=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Discord
DISCORD_APP_ID=your_application_id
DISCORD_USER_ID=your_user_id
DISCORD_BOT_TOKEN=your_bot_token

# Optional
# FORCE_MODE=music        # music | personal (default: automatic)
# UPDATE_INTERVAL=30      # seconds between checks (min 10)
# STATS_TTL=300           # seconds to cache Last.fm totals (min 30)
